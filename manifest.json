{
  "id": "automations",
  "name": "Automations",
  "version": "1.2.0",
  "description": "Run steps on your hosts on a schedule or when something happens.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Automations",
  "docs": "https://docs.termix.site/plugins/automations",
  "video": "https://www.youtube.com/watch?v=mHCil45TCB8",
  "category": "Infrastructure",
  "icon": "Workflow",
  "features": [
    "Triggers for metrics, hosts going up or down, health checks, schedules, container events and webhooks",
    "Steps that run commands and snippets, control containers and tunnels, wake hosts, call URLs and send alerts",
    "Conditions, waits and variables for more complex flows",
    "Run on one host, a fleet or every host",
    "Test runs and a history of every run",
    "Maintenance windows that pause automations while you work on a host",
    "An automations panel beside any SSH terminal, plus upcoming and recent run dashboard cards"
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "events:core",
    "notify:send",
    "network:outbound",
    "network:serve",
    "settings:read-core",
    "ui:surface",
    "users:impersonate"
  ],
  "optionalDependencies": {
    "fleets": "^1.0.0",
    "tunnels": "^1.0.0",
    "docker": "^1.0.0",
    "host-metrics": "^1.0.0",
    "wake-on-lan": "^1.0.0"
  },
  "requires": [
    {
      "service": "snippets.access",
      "versionRange": "^1.0.0"
    },
    {
      "service": "fleets.access",
      "versionRange": "^1.0.0",
      "optional": true
    },
    {
      "service": "tunnels.access",
      "versionRange": "^1.0.0",
      "optional": true
    },
    {
      "service": "docker.containers",
      "versionRange": "^1.0.0",
      "optional": true
    },
    {
      "service": "docker.events",
      "versionRange": "^1.0.0",
      "optional": true
    },
    {
      "service": "host-metrics.viewers",
      "versionRange": "^1.0.0",
      "optional": true
    },
    {
      "service": "wake-on-lan.send",
      "versionRange": "^1.0.0",
      "optional": true
    },
    {
      "service": "ai.tasks",
      "versionRange": "^1.0.0",
      "optional": true
    }
  ],
  "provides": [
    {
      "service": "automations.access",
      "version": "1.0.0",
      "permission": "automations.view"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "automations",
        "titleKey": "nav.automations",
        "icon": "Workflow",
        "openFrom": ["rail"]
      },
      {
        "id": "host_maintenance",
        "titleKey": "maintenance.title",
        "icon": "Wrench",
        "openFrom": ["host-context-menu"]
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "create",
        "titleKey": "permissions.create.title",
        "descriptionKey": "permissions.create.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "edit",
        "titleKey": "permissions.edit.title",
        "descriptionKey": "permissions.edit.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "delete",
        "titleKey": "permissions.delete.title",
        "descriptionKey": "permissions.delete.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "run",
        "titleKey": "permissions.run.title",
        "descriptionKey": "permissions.run.description",
        "defaultRoles": ["user"]
      }
    ],
    "uses": ["alerts.openChannels"],
    "settings": {
      "host": {
        "editorGroup": "ssh",
        "enableKey": "enableMaintenance",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "enableDefault": false,
        "fields": [
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true
          }
        ]
      },
      "user": [
        {
          "key": "alwaysShowActions",
          "type": "boolean",
          "labelKey": "settings.alwaysShowActions.label",
          "descriptionKey": "settings.alwaysShowActions.description",
          "default": false
        },
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.companionAutoOpen.label",
          "descriptionKey": "settings.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.companionSide.label",
          "descriptionKey": "settings.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.companionSize.label",
          "descriptionKey": "settings.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 320
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.companionEdgeButton.label",
          "descriptionKey": "settings.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "dashboardCards": [
      {
        "id": "automations-upcoming",
        "titleKey": "card.upcoming",
        "icon": "CalendarClock"
      },
      {
        "id": "automations-runs",
        "titleKey": "card.recentRuns",
        "icon": "History"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "dependencies": {
    "snippets": "^1.0.0"
  },
  "desktop": "server"
}
